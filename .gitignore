# Local env / secrets (Mistral key)
.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Pipeline artifacts — keep directories, ignore contents.
# data/raw/extracted/*.json are committed so a fresh clone can rebuild
# chunks/embeddings/vector store on boot (deploy bootstrap).
data/raw/html/**
!data/raw/html/.gitkeep
data/raw/extracted/**
!data/raw/extracted/*.json
!data/raw/extracted/.gitkeep
data/chunks/**
!data/chunks/.gitkeep
data/embeddings/**
!data/embeddings/.gitkeep
data/vector_db/**
!data/vector_db/.gitkeep
